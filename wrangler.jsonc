{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shared-bill-splitter-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shared-bill-splitter",
      "database_id": "local-development-database",
      "migrations_dir": "migrations"
    }
  ]
}